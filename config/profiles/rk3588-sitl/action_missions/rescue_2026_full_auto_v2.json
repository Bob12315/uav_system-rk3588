{
  "name": "rescue_2026_full_auto_v2",
  "description": "2026 完整救援 v2 aggressive scoring：起飞直飞第一扫描点、yaw 对齐、2×2 多视角定位与激进双载荷投放、侦察区逐目标检查、生成报告、返航降落。",
  "steps": [
    {
      "name": "takeoff",
      "label": "takeoff_5m",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "mode": "GUIDED",
        "altitude_m": 5.0,
        "altitude_tolerance_m": 0.35,
        "require_armed": true,
        "max_updates": 150,
        "priority": 2,
        "arm_priority": 1,
        "mode_priority": 2
      }
    },
    {
      "name": "resolve_gps_targets",
      "label": "resolve_first_scan_point",
      "save_as": "first_scan_point",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "targets": [
          {
            "source": "field",
            "field_x_m": -2.0,
            "field_y_m": 31.25,
            "altitude_m": 5.0
          }
        ],
        "key": "resolve_first_scan_point"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "goto_first_scan_point",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "x": "$first_scan_point.resolved_targets.0.local_x",
        "y": "$first_scan_point.resolved_targets.0.local_y",
        "altitude_m": 5.0,
        "waypoint_mode": "absolute",
        "target_frame": "local",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.8,
        "tolerance_z_m": 0.6,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "goto_first_scan_point"
      }
    },
    {
      "name": "yaw_align",
      "label": "yaw_align_before_scan",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "yaw_mode": "field_heading",
        "tolerance_deg": 3.0,
        "yaw_speed_deg_s": 25.0,
        "min_hold_updates": 5,
        "max_updates": 120,
        "priority": 4,
        "key": "yaw_align_before_scan"
      }
    },
    {
      "name": "multi_view_localize",
      "label": "drop_multi_view_scan",
      "save_as": "drop_scan",
      "on_failed": {
        "action": "jump_to",
        "target": "goto_recon_scan_center",
        "max_attempts": 1
      },
      "params": {
        "waypoint_mode": "field",
        "altitude_m": 5.0,
        "yaw_mode": "field_heading",
        "waypoints": [
          {"x": -2.0, "y": 31.25, "altitude_m": 5.0},
          {"x":  2.0, "y": 31.25, "altitude_m": 5.0},
          {"x":  2.0, "y": 33.75, "altitude_m": 5.0},
          {"x": -2.0, "y": 33.75, "altitude_m": 5.0}
        ],
        "capture_updates_per_waypoint": 6,
        "settle_updates_per_waypoint": 1,
        "max_updates_per_waypoint": 100,
        "tolerance_xy_m": 0.8,
        "tolerance_z_m": 0.6,
        "goto_min_hold_updates": 1,
        "detection_source": "scene",
        "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket"],
        "min_confidence": 0.30,
        "camera": {
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "yaw_offset_deg": 0.0
        },
        "fusion": {
          "cluster_radius_m": 1.0,
          "outlier_radius_m": 1.0,
          "min_cluster_size": 2,
          "max_cluster_radius_m": 1.2,
          "center_weight_power": 2.0,
          "max_abs_ex": 0.75,
          "max_abs_ey": 0.75,
          "max_objects": 3
        },
        "save_result": true,
        "priority": 5
      }
    },
    {
      "name": "resolve_gps_targets",
      "label": "resolve_drop_buckets",
      "save_as": "drop_buckets",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "targets": "$drop_scan.raw_estimates",
        "default_source": "vision",
        "camera": {
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "yaw_offset_deg": 0.0
        },
        "allow_context_pose_fallback": false,
        "key": "resolve_drop_buckets"
      }
    },
    {
      "name": "select_drop_targets",
      "label": "select_drop_targets",
      "save_as": "drop_targets",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "objects": "$drop_buckets.resolved_targets",
        "input_key": "resolved_targets",
        "target_count": 2,
        "allow_fewer": true,
        "score_table": {
          "bucket_1": 500,
          "bucket_2": 300,
          "bucket_3": 100,
          "bucket": 50
        },
        "min_seen_count": 1,
        "min_raw_count": 0,
        "min_weight": 0.0,
        "deduplicate_radius_m": 0.8,
        "prefer_class_order": ["bucket_1", "bucket_2", "bucket_3", "bucket"],
        "zone_center": {"x": 0.0, "y": 32.5},
        "zone_center_mode": "field"
      }
    },
    {
      "name": "drop_sequence",
      "label": "drop_sequence",
      "save_as": "drop_sequence",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "targets": "$drop_targets.target_slots",
        "payloads": [
          {
            "payload_id": "payload_1",
            "servo_outputs": [{"channel": 8, "release_pwm": 1750, "hold_pwm": 1250}],
            "payload_forward_m": -0.06,
            "payload_right_m": 0.0
          },
          {
            "payload_id": "payload_2",
            "servo_outputs": [{"channel": 9, "release_pwm": 1815, "hold_pwm": 1185}],
            "payload_forward_m": 0.06,
            "payload_right_m": 0.0
          }
        ],
        "max_target_candidates": 3,
        "max_payloads": 2,
        "approach_altitude_m": 3.0,
        "finish_altitude_m": 1.5,
        "climb_after_drop_m": 3.5,
        "goto_max_updates": 100,
        "target_lock_max_updates": 40,
        "align_descend_max_updates": 300,
        "climb_max_updates": 80,
        "fallback_release_when_last_target_failed": true,
        "release_all_payloads_if_only_one_target": true,
        "release_all_payloads_if_no_valid_targets": true,
        "continue_after_any_failure": true,
        "goto": {
          "waypoint_mode": "absolute",
          "yaw_mode": "field_heading",
          "tolerance_xy_m": 0.35,
          "tolerance_z_m": 0.35,
          "min_hold_updates": 1,
          "priority": 5
        },
        "target_lock": {
          "max_match_distance_m": 1.2,
          "detection_source": "scene",
          "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket"],
          "min_confidence": 0.35,
          "camera": {
            "fov_x_deg": 51.3,
            "fov_y_deg": 39.6,
            "image_x_sign": 1.0,
            "image_y_sign": -1.0
          }
        },
        "align_descend": {
          "expected_dt_s": 0.1,
          "lost_timeout_updates": 10,
          "hold_updates_required": 1,
          "max_retries": 1,
          "finish_altitude_m": 1.5,
          "config": {
            "kp_vx": 0.55,
            "kp_vy": 0.55,
            "max_vx_mps": 0.2,
            "max_vy_mps": 0.2,
            "height_gain_enabled": true,
            "height_gain_mode": "points",
            "height_scale_points": [
              {"altitude_m": 1.1, "scale": 0.20},
              {"altitude_m": 1.5, "scale": 0.25},
              {"altitude_m": 2.4, "scale": 0.55},
              {"altitude_m": 3.5, "scale": 0.55},
              {"altitude_m": 5.0, "scale": 0.55}
            ],
            "scale_max_velocity_with_height": true,
            "descend_speed_mps": 0.3,
            "slow_descend_speed_mps": 0.18,
            "max_ex_cam": 0.16,
            "max_ey_cam": 0.16,
            "slow_descend_max_ex_cam": 0.4,
            "slow_descend_max_ey_cam": 0.4,
            "deadband_ex_cam": 0.04,
            "deadband_ey_cam": 0.04,
            "min_altitude_m": 1.5,
            "require_target_locked": false,
            "payload_offset_enabled": true,
            "fov_x_deg": 51.3,
            "fov_y_deg": 39.6,
            "image_x_sign": 1.0,
            "image_y_sign": -1.0,
            "max_payload_offset_ex_cam": 0.8,
            "max_payload_offset_ey_cam": 0.8
          }
        }
      }
    },
    {
      "name": "goto_waypoint",
      "label": "goto_recon_scan_center",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home",
        "max_attempts": 1
      },
      "params": {
        "x": 0.0,
        "y": 57.5,
        "altitude_m": 5.0,
        "waypoint_mode": "field",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.5,
        "tolerance_z_m": 0.5,
        "min_hold_updates": 10,
        "priority": 5,
        "key": "goto_recon_scan_center"
      }
    },
    {
      "name": "fixed_view_localize",
      "label": "recon_scan",
      "save_as": "recon_scan",
      "on_failed": {
        "action": "retry_current_then_jump_to",
        "max_attempts": 2,
        "target": "return_home"
      },
      "params": {
        "altitude_m": 5.0,
        "capture_updates": 12,
        "detection_source": "scene",
        "class_names": ["recon_bucket", "white_bucket", "bucket"],
        "min_confidence": 0.25,
        "camera": {
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0
        },
        "settle_updates": 8,
        "max_updates": 40,
        "save_result": true,
        "fusion": {
          "cluster_radius_m": 0.7,
          "outlier_radius_m": 0.8,
          "min_cluster_size": 2,
          "max_cluster_radius_m": 0.9,
          "center_weight_power": 1.0,
          "max_objects": 8
        }
      }
    },
    {
      "name": "select_recon_targets",
      "label": "select_recon_targets",
      "save_as": "recon_targets",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home",
        "max_attempts": 1
      },
      "params": {
        "objects": "$recon_scan.localized_objects",
        "target_count": 5,
        "allow_fewer": true,
        "min_seen_count": 1,
        "min_raw_count": 0,
        "min_weight": 0.0,
        "deduplicate_radius_m": 0.45,
        "class_names": ["recon_bucket", "white_bucket", "bucket"],
        "zone_center": {"x": 0.0, "y": 57.5},
        "zone_center_mode": "field"
      }
    },
    {
      "name": "recon_sequence",
      "label": "recon_sequence",
      "save_as": "recon_sequence",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home",
        "max_attempts": 1
      },
      "params": {
        "targets": "$recon_targets.target_slots",
        "max_targets": 5,
        "approach_altitude_m": 2.5,
        "finish_altitude_m": 1.5,
        "climb_after_observe_m": 2.5,
        "goto_max_updates": 120,
        "target_lock_max_updates": 40,
        "observe_max_updates": 200,
        "climb_max_updates": 100,
        "continue_after_target_failure": true,
        "goto": {
          "waypoint_mode": "absolute",
          "yaw_mode": "field_heading",
          "tolerance_xy_m": 0.35,
          "tolerance_z_m": 0.35,
          "min_hold_updates": 1,
          "priority": 5
        },
        "target_lock": {
          "max_match_distance_m": 1.2,
          "detection_source": "scene",
          "class_names": ["recon_bucket", "white_bucket", "bucket"],
          "min_confidence": 0.25,
          "camera": {
            "fov_x_deg": 85.0,
            "fov_y_deg": 69.0,
            "image_x_sign": 1.0,
            "image_y_sign": -1.0
          }
        },
        "observe": {
          "record_start_altitude_m": 2.0,
          "finish_altitude_m": 1.5,
          "detection_source": "scene",
          "sign_class_names": [
            "baozha", "shenghua", "yiran", "fangshe", "buran",
            "fushi", "youdu", "yushi", "ziran", "ciji",
            "danger_1", "danger_2", "danger_3"
          ],
          "min_sign_confidence": 0.35,
          "min_seen_frames": 3,
          "min_confidence_max": 0.55,
          "min_confidence_mean": 0.40,
          "min_score": 1.2,
          "min_margin_ratio": 1.4,
          "align_descend": {
            "expected_dt_s": 0.1,
            "lost_timeout_updates": 8,
            "hold_updates_required": 1,
            "max_retries": 1,
            "max_updates": 200,
            "finish_altitude_m": 1.5,
            "config": {
              "descent_gate_policy": "allow_unaligned",
              "unaligned_descend_speed_mps": 0.06,
              "kp_vx": 0.35,
              "kp_vy": 0.35,
              "max_vx_mps": 0.12,
              "max_vy_mps": 0.12,
              "descend_speed_mps": 0.16,
              "slow_descend_speed_mps": 0.10,
              "max_ex_cam": 0.18,
              "max_ey_cam": 0.18,
              "slow_descend_max_ex_cam": 0.45,
              "slow_descend_max_ey_cam": 0.45,
              "deadband_ex_cam": 0.04,
              "deadband_ey_cam": 0.04,
              "min_altitude_m": 1.5,
              "require_target_locked": false,
              "payload_offset_enabled": false
            }
          }
        }
      }
    },
    {
      "name": "build_recon_report",
      "label": "build_recon_report",
      "save_as": "recon_report",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "items": "$recon_sequence.recon_result_items"
      }
    },
    {
      "name": "resolve_gps_targets",
      "label": "resolve_home",
      "save_as": "home_waypoint",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "targets": [
          {
            "source": "home",
            "altitude_m": 5.0
          }
        ],
        "key": "resolve_home"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "return_home",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "x": "$home_waypoint.resolved_targets.0.local_x",
        "y": "$home_waypoint.resolved_targets.0.local_y",
        "altitude_m": 5.0,
        "waypoint_mode": "absolute",
        "target_frame": "local",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.7,
        "tolerance_z_m": 0.5,
        "min_hold_updates": 2,
        "priority": 5,
        "key": "return_home"
      }
    },
    {
      "name": "land",
      "label": "land_home",
      "params": {
        "land_altitude_threshold_m": 0.25,
        "max_updates": 250,
        "priority": 2,
        "key": "land_home"
      }
    }
  ]
}
