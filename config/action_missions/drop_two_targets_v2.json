{
  "name": "drop_two_targets_v2",
  "description": "投放任务 v2 GPS 全移动 + BODY_NED 视觉对准下降：起飞后 GPS 飞扫描点、多视角扫描（WGS84 航点）、GPS 飞投放目标上方、align_descend BODY_NED 下降、爬升返航 GPS。",
  "steps": [
    {
      "name": "takeoff",
      "label": "takeoff_5m",
      "params": {
        "mode": "GUIDED",
        "altitude_m": 5.0,
        "altitude_tolerance_m": 0.35,
        "require_armed": true,
        "max_updates": 150,
        "priority": 2,
        "arm_priority": 1,
        "mode_priority": 2
      }
    },
    {
      "name": "resolve_gps_targets",
      "label": "resolve_home_gps",
      "save_as": "home_waypoint",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "targets": [
          {
            "source": "home",
            "altitude_m": 3.5
          }
        ],
        "key": "resolve_home_gps"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "goto_first_scan_point_gps",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "x": 34.10364806,
        "y": 108.64301159,
        "altitude_m": 5.0,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.8,
        "tolerance_z_m": 0.6,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "goto_first_scan_point_gps"
      }
    },
    {
      "name": "yaw_align",
      "label": "yaw_align_before_scan",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "yaw_mode": "field_heading",
        "tolerance_deg": 3.0,
        "yaw_speed_deg_s": 25.0,
        "min_hold_updates": 5,
        "max_updates": 120,
        "priority": 4,
        "key": "yaw_align_before_scan"
      }
    },
    {
      "name": "multi_view_localize",
      "label": "drop_multi_view_scan",
      "save_as": "drop_scan",
      "on_failed": {
        "action": "retry_current_then_jump_to",
        "max_attempts": 2,
        "target": "return_home_gps"
      },
      "params": {
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "altitude_m": 5.0,
        "yaw_mode": "hold",
        "waypoints": [
          {"x": 34.10364806, "y": 108.64301159, "altitude_m": 5.0},
          {"x": 34.10361200, "y": 108.64301179, "altitude_m": 5.0},
          {"x": 34.10361210, "y": 108.64303888, "altitude_m": 5.0},
          {"x": 34.10364816, "y": 108.64303869, "altitude_m": 5.0}
        ],
        "capture_updates_per_waypoint": 6,
        "settle_updates_per_waypoint": 1,
        "max_updates_per_waypoint": 100,
        "tolerance_xy_m": 0.8,
        "tolerance_z_m": 0.6,
        "goto_min_hold_updates": 1,
        "detection_source": "scene",
        "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket"],
        "min_confidence": 0.30,
        "camera": {
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "yaw_offset_deg": 0.0
        },
        "fusion": {
          "cluster_radius_m": 1.0,
          "outlier_radius_m": 1.0,
          "min_cluster_size": 2,
          "max_cluster_radius_m": 1.2,
          "center_weight_power": 2.0,
          "max_abs_ex": 0.75,
          "max_abs_ey": 0.75,
          "max_objects": 3
        },
        "save_result": true,
        "allow_empty_result": true,
        "priority": 5
      }
    },
    {
      "name": "resolve_gps_targets",
      "label": "resolve_drop_buckets",
      "save_as": "drop_buckets",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "targets": "$drop_scan.raw_estimates",
        "default_source": "vision",
        "camera": {
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "yaw_offset_deg": 0.0
        },
        "allow_context_pose_fallback": false,
        "allow_empty_result": true,
        "key": "resolve_drop_buckets"
      }
    },
    {
      "name": "select_drop_targets",
      "label": "select_drop_targets",
      "save_as": "drop_targets",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "objects": "$drop_buckets.resolved_targets",
        "input_key": "resolved_targets",
        "target_count": 2,
        "allow_fewer": true,
        "score_table": {
          "bucket_1": 500,
          "bucket_2": 300,
          "bucket_3": 100,
          "bucket": 50
        },
        "min_seen_count": 2,
        "min_raw_count": 0,
        "min_weight": 0.0,
        "deduplicate_radius_m": 0.8,
        "prefer_class_order": ["bucket_1", "bucket_2", "bucket_3", "bucket"],
        "single_target_servo_outputs": [
          { "channel": 8, "release_pwm": 1750, "hold_pwm": 1250 },
          { "channel": 9, "release_pwm": 1815, "hold_pwm": 1185 }
        ],
        "multi_target_first_servo_outputs": [
          { "channel": 8, "release_pwm": 1750, "hold_pwm": 1250 }
        ]
      }
    },
    {
      "name": "validate_target",
      "label": "validate_drop_target_0",
      "params": {
        "target": "$drop_targets.target_slots.0",
        "require_valid": true,
        "require_lat_lon": true
      },
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "goto_drop_target_0_gps",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps"
      },
      "params": {
        "x": "$drop_targets.target_slots.0.lat",
        "y": "$drop_targets.target_slots.0.lon",
        "altitude_m": 2.5,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "skip_if_invalid_target": true,
        "priority": 5,
        "key": "goto_drop_target_0_gps"
      }
    },
    {
      "name": "align_descend",
      "label": "align_descend_0",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "require_target_locked": false,
        "expected_dt_s": 0.1,
        "lost_timeout_updates": 10,
        "hold_updates_required": 1,
        "max_retries": 1,
        "finish_altitude_m": 1.2,
        "min_altitude_m": 1.2,
        "max_updates": 160,
        "config": {
          "kp_vx": 0.55,
          "kp_vy": 0.55,
          "max_vx_mps": 0.2,
          "max_vy_mps": 0.2,
          "height_gain_enabled": true,
          "height_gain_mode": "points",
          "height_scale_points": [
            { "altitude_m": 1.0, "scale": 0.30 },
            { "altitude_m": 1.3, "scale": 0.25 },
            { "altitude_m": 2.4, "scale": 0.55 },
            { "altitude_m": 3.5, "scale": 0.55 },
            { "altitude_m": 4.5, "scale": 0.55 }
          ],
          "scale_max_velocity_with_height": true,
          "descend_speed_mps": 0.30,
          "slow_descend_speed_mps": 0.18,
          "max_ex_cam": 0.16,
          "max_ey_cam": 0.16,
          "slow_descend_max_ex_cam": 0.4,
          "slow_descend_max_ey_cam": 0.4,
          "deadband_ex_cam": 0.04,
          "deadband_ey_cam": 0.04,
          "min_altitude_m": 1.2,
          "require_target_locked": false,
          "payload_offset_enabled": true,
          "payload_forward_m": -0.06,
          "payload_right_m": 0.0,
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "max_payload_offset_ex_cam": 0.8,
          "max_payload_offset_ey_cam": 0.8
        }
      }
    },
    {
      "name": "payload_release",
      "label": "payload_release_1",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "servo_outputs": [
          { "channel": 8, "release_pwm": 1750, "hold_pwm": 1250 }
        ],
        "release_wait_updates": 5,
        "priority": 3,
        "key": "payload_release_1"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "climb_after_payload_1_gps",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "x": "$drop_targets.target_slots.0.lat",
        "y": "$drop_targets.target_slots.0.lon",
        "altitude_m": 3.5,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "skip_if_invalid_target": true,
        "priority": 5,
        "key": "climb_after_payload_1_gps"
      }
    },
    {
      "name": "validate_target",
      "label": "validate_drop_target_1",
      "params": {
        "target": "$drop_targets.target_slots.1",
        "require_valid": true,
        "require_lat_lon": true
      },
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "goto_drop_target_1_gps",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps"
      },
      "params": {
        "x": "$drop_targets.target_slots.1.lat",
        "y": "$drop_targets.target_slots.1.lon",
        "altitude_m": 2.5,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "skip_if_invalid_target": true,
        "priority": 5,
        "key": "goto_drop_target_1_gps"
      }
    },
    {
      "name": "align_descend",
      "label": "align_descend_1",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "require_target_locked": false,
        "expected_dt_s": 0.1,
        "lost_timeout_updates": 10,
        "hold_updates_required": 1,
        "max_retries": 1,
        "finish_altitude_m": 1.2,
        "min_altitude_m": 1.2,
        "max_updates": 160,
        "config": {
          "kp_vx": 0.55,
          "kp_vy": 0.55,
          "max_vx_mps": 0.2,
          "max_vy_mps": 0.2,
          "height_gain_enabled": true,
          "height_gain_mode": "points",
          "height_scale_points": [
            { "altitude_m": 1.0, "scale": 0.30 },
            { "altitude_m": 1.3, "scale": 0.25 },
            { "altitude_m": 2.4, "scale": 0.55 },
            { "altitude_m": 3.5, "scale": 0.55 },
            { "altitude_m": 4.5, "scale": 0.55 }
          ],
          "scale_max_velocity_with_height": true,
          "descend_speed_mps": 0.30,
          "slow_descend_speed_mps": 0.18,
          "max_ex_cam": 0.16,
          "max_ey_cam": 0.16,
          "slow_descend_max_ex_cam": 0.4,
          "slow_descend_max_ey_cam": 0.4,
          "deadband_ex_cam": 0.04,
          "deadband_ey_cam": 0.04,
          "min_altitude_m": 1.2,
          "require_target_locked": false,
          "payload_offset_enabled": true,
          "payload_forward_m": 0.06,
          "payload_right_m": 0.0,
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "max_payload_offset_ex_cam": 0.8,
          "max_payload_offset_ey_cam": 0.8
        }
      }
    },
    {
      "name": "payload_release",
      "label": "payload_release_2",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "servo_outputs": [
          { "channel": 9, "release_pwm": 1815, "hold_pwm": 1185 }
        ],
        "release_wait_updates": 5,
        "priority": 3,
        "key": "payload_release_2"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "climb_after_payload_2_gps",
      "on_failed": {
        "action": "continue"
      },
      "params": {
        "x": "$drop_targets.target_slots.1.lat",
        "y": "$drop_targets.target_slots.1.lon",
        "altitude_m": 3.5,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "skip_if_invalid_target": true,
        "priority": 5,
        "key": "climb_after_payload_2_gps"
      }
    },
    {
      "name": "goto_waypoint",
      "label": "return_home_gps",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "x": "$home_waypoint.resolved_targets.0.lat",
        "y": "$home_waypoint.resolved_targets.0.lon",
        "altitude_m": 3.5,
        "waypoint_mode": "absolute",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.7,
        "tolerance_z_m": 0.5,
        "min_hold_updates": 2,
        "priority": 5,
        "key": "return_home_gps"
      }
    },
    {
      "name": "land",
      "label": "land_home",
      "params": {
        "land_altitude_threshold_m": 0.25,
        "max_updates": 250,
        "priority": 2,
        "key": "land_home"
      }
    }
  ]
}
