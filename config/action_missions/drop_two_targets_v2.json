{
  "version": 2,
  "profile": "v3-default",
  "steps": [
    {
      "name": "takeoff",
      "label": "takeoff_5m",
      "params": {
        "mode": "GUIDED",
        "altitude_m": 5.0,
        "altitude_tolerance_m": 0.35,
        "require_armed": true,
        "max_updates": 150,
        "priority": 2,
        "arm_priority": 1,
        "mode_priority": 2
      },
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      }
    },
    {
      "name": "yaw_align",
      "label": "yaw_align_before_scan",
      "params": {
        "yaw_mode": "field_heading",
        "tolerance_deg": 3.0,
        "yaw_speed_deg_s": 25.0,
        "min_hold_updates": 5,
        "max_updates": 120,
        "priority": 4
      },
      "on_failed": {
        "action": "continue",
        "max_attempts": 1
      }
    },
    {
      "name": "gps_multi_view_localize",
      "label": "drop_gps_multi_view_scan",
      "save_as": "drop_scan",
      "on_failed": {
        "action": "retry_current_then_jump_to",
        "max_attempts": 2,
        "target": "return_home_gps"
      },
      "params": {
        "capture_updates_per_waypoint": 6,
        "settle_updates_per_waypoint": 2,
        "max_updates_per_waypoint": 120,
        "tolerance_xy_m": 0.5,
        "tolerance_z_m": 0.5,
        "goto_min_hold_updates": 2,
        "yaw_mode": "hold",
        "detection_source": "scene",
        "class_names": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "min_confidence": 0.3,
        "camera": {
          "fov_x_deg": 51.3,
          "fov_y_deg": 39.6,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0
        },
        "fusion": {
          "cluster_radius_m": 0.8,
          "outlier_radius_m": 0.8,
          "min_cluster_size": 2,
          "center_weight_power": 1.0
        },
        "priority": 5
      }
    },
    {
      "name": "select_drop_targets",
      "label": "select_gps_drop_targets",
      "save_as": "drop_targets",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps",
        "max_attempts": 1
      },
      "params": {
        "objects": "$drop_scan.localized_objects",
        "coordinate_mode": "gps_enu",
        "target_count": 2,
        "allow_fewer": false,
        "score_table": {
          "bucket_1": 500,
          "bucket_2": 300,
          "bucket_3": 100,
          "bucket": 50
        },
        "min_seen_count": 2,
        "min_raw_count": 2,
        "min_weight": 0.0,
        "deduplicate_radius_m": 0.8,
        "prefer_class_order": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "key": "select_gps_drop_targets"
      }
    },
    {
      "name": "gps_drop_sequence",
      "label": "gps_drop_sequence",
      "save_as": "drop_sequence",
      "on_failed": {
        "action": "jump_to",
        "target": "return_home_gps",
        "max_attempts": 1
      },
      "params": {
        "targets": "$drop_targets.target_slots",
        "payloads": [
          {
            "payload_id": "payload_1",
            "servo_outputs": [
              {
                "channel": 8,
                "release_pwm": 1750,
                "hold_pwm": 1250
              }
            ],
            "priority": 3
          },
          {
            "payload_id": "payload_2",
            "servo_outputs": [
              {
                "channel": 9,
                "release_pwm": 1815,
                "hold_pwm": 1185
              }
            ],
            "priority": 3
          }
        ],
        "approach_altitude_m": 3.5,
        "finish_altitude_m": 1.3,
        "climb_after_drop_m": 5.0,
        "goto_max_updates": 200,
        "target_lock_max_updates": 60,
        "align_descend_max_updates": 250,
        "climb_max_updates": 160,
        "release_wait_updates": 5,
        "goto": {
          "tolerance_xy_m": 0.25,
          "tolerance_z_m": 0.25,
          "min_hold_updates": 5
        },
        "target_lock": {
          "max_match_distance_m": 1.2,
          "min_confidence": 0.35,
          "class_names": [
            "bucket_1",
            "bucket_2",
            "bucket_3",
            "bucket"
          ],
          "detection_source": "scene",
          "camera": {
            "fov_x_deg": 51.3,
            "fov_y_deg": 39.6,
            "image_x_sign": 1.0,
            "image_y_sign": -1.0
          }
        },
        "align_descend": {
          "finish_policy": "require_alignment_or_timeout",
          "expected_dt_s": 0.1,
          "lost_timeout_updates": 10,
          "hold_updates_required": 3,
          "max_retries": 1,
          "max_updates": 250,
          "config": {
            "min_altitude_m": 1.3,
            "require_target_locked": true,
            "kp_vx": 0.55,
            "kp_vy": 0.55,
            "max_vx_mps": 0.2,
            "max_vy_mps": 0.2,
            "descend_speed_mps": 0.3,
            "slow_descend_speed_mps": 0.18,
            "max_ex_cam": 0.16,
            "max_ey_cam": 0.16,
            "deadband_ex_cam": 0.04,
            "deadband_ey_cam": 0.04,
            "fov_x_deg": 51.3,
            "fov_y_deg": 39.6,
            "image_x_sign": 1.0,
            "image_y_sign": -1.0
          }
        }
      }
    },
    {
      "name": "goto_waypoint",
      "label": "return_home_gps",
      "on_failed": {
        "action": "jump_to",
        "target": "land_home",
        "max_attempts": 1
      },
      "params": {
        "x": 0.0,
        "y": 0.0,
        "altitude_m": 5.0,
        "waypoint_mode": "field",
        "target_frame": "global",
        "yaw_mode": "hold",
        "tolerance_xy_m": 0.7,
        "tolerance_z_m": 0.5,
        "min_hold_updates": 2,
        "priority": 5,
        "key": "return_home_gps"
      }
    },
    {
      "name": "land",
      "label": "land_home",
      "params": {
        "max_updates": 300,
        "priority": 2
      }
    }
  ],
  "name": "drop_two_targets_v2",
  "description": "GPS-first dual-target drop mission v2"
}