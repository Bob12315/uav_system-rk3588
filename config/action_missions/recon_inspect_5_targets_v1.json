{
  "name": "recon_inspect_5_targets_v1",
  "description": "Recon-only mission: four-point multi-view localization, inspect up to 5 buckets, descend to 2m for danger sign recognition, return home.",
  "steps": [
    {
      "name": "takeoff",
      "params": {"mode": "GUIDED", "altitude_m": 4.5, "altitude_tolerance_m": 0.35, "require_armed": true, "max_updates": 150, "priority": 2, "arm_priority": 1, "mode_priority": 2, "auto_confirm_field_heading": true}
    },
    {
      "name": "multi_view_localize", "label": "recon_scan", "save_as": "recon_scan",
      "on_failed": {"action": "jump_to", "target": "return_home", "max_attempts": 1},
      "params": {
        "waypoint_mode": "field", "altitude_m": 4.5, "yaw_mode": "field_heading",
        "waypoints": [{"x": -1.5, "y": 4.0, "altitude_m": 4.5}, {"x": 1.5, "y": 4.0, "altitude_m": 4.5}, {"x": 1.5, "y": 6.0, "altitude_m": 4.5}, {"x": -1.5, "y": 6.0, "altitude_m": 4.5}],
        "capture_updates_per_waypoint": 4, "settle_updates_per_waypoint": 2, "max_updates_per_waypoint": 120,
        "tolerance_xy_m": 0.35, "tolerance_z_m": 0.35, "goto_min_hold_updates": 1,
        "detection_source": "scene", "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket", "recon_bucket", "white_bucket"], "min_confidence": 0.25,
        "camera": {"fov_x_deg": 85.0, "fov_y_deg": 69.0, "image_x_sign": 1.0, "image_y_sign": -1.0},
        "fusion": {"cluster_radius_m": 0.8, "outlier_radius_m": 0.8, "min_cluster_size": 1, "center_weight_power": 1.0},
        "save_result": true, "priority": 5
      }
    },
    {
      "name": "select_recon_targets", "label": "select_recon_targets", "save_as": "recon_targets",
      "on_failed": {"action": "jump_to", "target": "return_home", "max_attempts": 1},
      "params": {"objects": "$recon_scan.localized_objects", "target_count": 5, "allow_fewer": true, "min_seen_count": 1, "min_raw_count": 0, "min_weight": 0.0, "deduplicate_radius_m": 0.45, "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket", "recon_bucket", "white_bucket"], "zone_center": {"x": 0.0, "y": 5.0}}
    },
    {
      "name": "recon_inspect_targets", "save_as": "recon_inspection",
      "on_failed": {"action": "jump_to", "target": "return_home", "max_attempts": 1},
      "params": {
        "targets": "$recon_targets.selected_targets", "max_targets": 5, "inspect_altitude_m": 3.0, "align_finish_altitude_m": 2.0,
        "waypoint_mode": "absolute", "yaw_mode": "field_heading", "goto_tolerance_xy_m": 0.35, "goto_tolerance_z_m": 0.35, "goto_min_hold_updates": 1,
        "target_lock": {"max_match_distance_m": 1.2, "detection_source": "scene", "class_names": ["bucket_1", "bucket_2", "bucket_3", "bucket", "recon_bucket", "white_bucket"], "min_confidence": 0.25, "max_updates": 25},
        "align_descend": {
          "expected_dt_s": 0.1, "lost_timeout_updates": 8, "hold_updates_required": 1, "max_retries": 1, "max_updates": 140, "finish_altitude_m": 2.0,
          "config": {"kp_vx": 0.5, "kp_vy": 0.5, "max_vx_mps": 0.18, "max_vy_mps": 0.18, "height_gain_enabled": true, "height_gain_mode": "points", "height_scale_points": [{"altitude_m": 1.2, "scale": 0.2}, {"altitude_m": 1.3, "scale": 0.25}, {"altitude_m": 2.4, "scale": 0.55}, {"altitude_m": 3.5, "scale": 0.55}, {"altitude_m": 4.5, "scale": 0.55}], "scale_max_velocity_with_height": true, "descend_speed_mps": 0.22, "slow_descend_speed_mps": 0.12, "max_ex_cam": 0.18, "max_ey_cam": 0.18, "slow_descend_max_ex_cam": 0.25, "slow_descend_max_ey_cam": 0.25, "deadband_ex_cam": 0.04, "deadband_ey_cam": 0.04, "min_altitude_m": 1.8, "require_target_locked": false, "payload_offset_enabled": false, "fov_x_deg": 85.0, "fov_y_deg": 69.0, "image_x_sign": 1.0, "image_y_sign": -1.0}
        },
        "capture_sign": {"detection_source": "scene", "capture_updates": 8, "min_sign_confidence": 0.35, "sign_class_names": ["danger_1", "danger_2", "danger_3", "baozha", "shenghua", "yiran", "fangshe", "buran", "fushi", "youdu", "yushi", "ziran", "ciji"]},
        "continue_on_target_failed": true, "continue_when_no_sign": true, "priority": 5
      }
    },
    {
      "name": "goto_waypoint", "label": "return_home",
      "params": {"x": 0.0, "y": 0.0, "altitude_m": 3.0, "waypoint_mode": "field", "yaw_mode": "field_heading", "tolerance_xy_m": 0.5, "tolerance_z_m": 0.5, "min_hold_updates": 2, "priority": 5, "key": "return_home_after_recon"}
    }
  ]
}
