{
  "name": "drop_two_targets_v1",
  "description": "Two-payload drop mission \u2014 real-hardware default baseline. Stable flow over speed.",
  "steps": [
    {
      "name": "takeoff",
      "params": {
        "mode": "GUIDED",
        "altitude_m": 4.5,
        "altitude_tolerance_m": 0.35,
        "require_armed": true,
        "max_updates": 150,
        "priority": 2,
        "arm_priority": 1,
        "mode_priority": 2,
        "auto_confirm_field_heading": true
      }
    },
    {
      "name": "multi_view_localize",
      "save_as": "drop_scan",
      "params": {
        "waypoint_mode": "field",
        "altitude_m": 4.5,
        "yaw_mode": "field_heading",
        "waypoints": [
          {
            "x": -1.5,
            "y": 31,
            "altitude_m": 4.5
          },
          {
            "x": 1.5,
            "y": 31,
            "altitude_m": 4.5
          },
          {
            "x": 1.5,
            "y": 34,
            "altitude_m": 4.5
          },
          {
            "x": -1.5,
            "y": 34,
            "altitude_m": 4.5
          }
        ],
        "capture_updates_per_waypoint": 3,
        "settle_updates_per_waypoint": 2,
        "max_updates_per_waypoint": 100,
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "goto_min_hold_updates": 1,
        "detection_source": "scene",
        "class_names": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "min_confidence": 0.35,
        "camera": {
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0
        },
        "fusion": {
          "cluster_radius_m": 0.8,
          "outlier_radius_m": 0.8,
          "min_cluster_size": 2,
          "center_weight_power": 1.0
        },
        "save_result": true,
        "priority": 5
      }
    },
    {
      "name": "select_drop_targets",
      "save_as": "drop_targets",
      "params": {
        "objects": "$drop_scan.localized_objects",
        "target_count": 2,
        "score_table": {
          "bucket_1": 500,
          "bucket_2": 300,
          "bucket_3": 100,
          "bucket": 50
        },
        "min_seen_count": 2,
        "min_raw_count": 0,
        "min_weight": 0.0,
        "deduplicate_radius_m": 0.6,
        "prefer_class_order": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "zone_center": {
          "x": 0.0,
          "y": 5.5
        }
      }
    },
    {
      "name": "goto_waypoint",
      "params": {
        "x": "$drop_targets.selected_targets.0.local_x",
        "y": "$drop_targets.selected_targets.0.local_y",
        "altitude_m": 2.5,
        "waypoint_mode": "absolute",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "goto_drop_target_0"
      }
    },
    {
      "name": "target_lock",
      "params": {
        "target": {
          "local_x": "$drop_targets.selected_targets.0.local_x",
          "local_y": "$drop_targets.selected_targets.0.local_y"
        },
        "max_match_distance_m": 1.2,
        "detection_source": "scene",
        "class_names": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "min_confidence": 0.35,
        "camera": {
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0
        },
        "max_updates": 25,
        "key": "target_lock_0"
      }
    },
    {
      "name": "align_descend",
      "params": {
        "expected_dt_s": 0.1,
        "lost_timeout_updates": 10,
        "hold_updates_required": 1,
        "max_retries": 1,
        "max_updates": 160,
        "finish_altitude_m": 1.2,
        "config": {
          "kp_vx": 0.55,
          "kp_vy": 0.55,
          "max_vx_mps": 0.20,
          "max_vy_mps": 0.20,
          "height_gain_enabled": true,
          "height_gain_mode": "points",
          "height_scale_points": [
            {
              "altitude_m": 1.0,
              "scale": 0.30
            },
            {
              "altitude_m": 1.3,
              "scale": 0.25
            },
            {
              "altitude_m": 2.4,
              "scale": 0.55
            },
            {
              "altitude_m": 3.5,
              "scale": 0.55
            },
            {
              "altitude_m": 4.5,
              "scale": 0.55
            }
          ],
          "scale_max_velocity_with_height": true,
          "descend_speed_mps": 0.30,
          "slow_descend_speed_mps": 0.18,
          "max_ex_cam": 0.16,
          "max_ey_cam": 0.16,
          "slow_descend_max_ex_cam": 0.40,
          "slow_descend_max_ey_cam": 0.40,
          "deadband_ex_cam": 0.04,
          "deadband_ey_cam": 0.04,
          "min_altitude_m": 1.2,
          "require_target_locked": false,
          "payload_offset_enabled": true,
          "payload_forward_m": -0.06,
          "payload_right_m": 0.0,
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "max_payload_offset_ex_cam": 0.8,
          "max_payload_offset_ey_cam": 0.8
        }
      }
    },
    {
      "name": "payload_release",
      "params": {
        "servo_outputs": [
          {
            "channel": 8,
            "release_pwm": 1750,
            "hold_pwm": 1250
          }
        ],
        "payload_id": "payload_1",
        "target_id": "$drop_targets.selected_targets.0.id",
        "release_wait_updates": 5,
        "priority": 3,
        "key": "payload_release_1"
      }
    },
    {
      "name": "goto_waypoint",
      "params": {
        "x": "$drop_targets.selected_targets.0.local_x",
        "y": "$drop_targets.selected_targets.0.local_y",
        "altitude_m": 3.5,
        "waypoint_mode": "absolute",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.4,
        "tolerance_z_m": 0.4,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "climb_after_payload_1"
      }
    },
    {
      "name": "goto_waypoint",
      "params": {
        "x": "$drop_targets.selected_targets.1.local_x",
        "y": "$drop_targets.selected_targets.1.local_y",
        "altitude_m": 2.5,
        "waypoint_mode": "absolute",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.35,
        "tolerance_z_m": 0.35,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "goto_drop_target_1"
      }
    },
    {
      "name": "target_lock",
      "params": {
        "target": {
          "local_x": "$drop_targets.selected_targets.1.local_x",
          "local_y": "$drop_targets.selected_targets.1.local_y"
        },
        "max_match_distance_m": 1.2,
        "detection_source": "scene",
        "class_names": [
          "bucket_1",
          "bucket_2",
          "bucket_3",
          "bucket"
        ],
        "min_confidence": 0.35,
        "camera": {
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0
        },
        "max_updates": 25,
        "key": "target_lock_1"
      }
    },
    {
      "name": "align_descend",
      "params": {
        "expected_dt_s": 0.1,
        "lost_timeout_updates": 10,
        "hold_updates_required": 1,
        "max_retries": 1,
        "max_updates": 160,
        "finish_altitude_m": 1.2,
        "config": {
          "kp_vx": 0.55,
          "kp_vy": 0.55,
          "max_vx_mps": 0.20,
          "max_vy_mps": 0.20,
          "height_gain_enabled": true,
          "height_gain_mode": "points",
          "height_scale_points": [
            {
              "altitude_m": 1.0,
              "scale": 0.30
            },
            {
              "altitude_m": 1.3,
              "scale": 0.25
            },
            {
              "altitude_m": 2.4,
              "scale": 0.55
            },
            {
              "altitude_m": 3.5,
              "scale": 0.55
            },
            {
              "altitude_m": 4.5,
              "scale": 0.55
            }
          ],
          "scale_max_velocity_with_height": true,
          "descend_speed_mps": 0.30,
          "slow_descend_speed_mps": 0.18,
          "max_ex_cam": 0.16,
          "max_ey_cam": 0.16,
          "slow_descend_max_ex_cam": 0.40,
          "slow_descend_max_ey_cam": 0.40,
          "deadband_ex_cam": 0.04,
          "deadband_ey_cam": 0.04,
          "min_altitude_m": 1.2,
          "require_target_locked": false,
          "payload_offset_enabled": true,
          "payload_forward_m": 0.06,
          "payload_right_m": 0.0,
          "fov_x_deg": 85.0,
          "fov_y_deg": 69.0,
          "image_x_sign": 1.0,
          "image_y_sign": -1.0,
          "max_payload_offset_ex_cam": 0.8,
          "max_payload_offset_ey_cam": 0.8
        }
      }
    },
    {
      "name": "payload_release",
      "params": {
        "servo_outputs": [
          {
            "channel": 9,
            "release_pwm": 1815,
            "hold_pwm": 1185
          }
        ],
        "payload_id": "payload_2",
        "target_id": "$drop_targets.selected_targets.1.id",
        "release_wait_updates": 5,
        "priority": 3,
        "key": "payload_release_2"
      }
    },
    {
      "name": "goto_waypoint",
      "params": {
        "x": "$drop_targets.selected_targets.1.local_x",
        "y": "$drop_targets.selected_targets.1.local_y",
        "altitude_m": 3.5,
        "waypoint_mode": "absolute",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.4,
        "tolerance_z_m": 0.4,
        "min_hold_updates": 1,
        "priority": 5,
        "key": "climb_after_payload_2"
      }
    },
    {
      "name": "goto_waypoint",
      "params": {
        "x": 0.0,
        "y": 0.0,
        "altitude_m": 3.5,
        "waypoint_mode": "field",
        "yaw_mode": "field_heading",
        "tolerance_xy_m": 0.5,
        "tolerance_z_m": 0.5,
        "min_hold_updates": 2,
        "priority": 5,
        "key": "return_home"
      }
    },
    {
      "name": "land",
      "params": {
        "land_altitude_threshold_m": 0.25,
        "max_updates": 250,
        "priority": 2,
        "key": "land_home"
      }
    }
  ]
}
